const float PI = 3.14159265359;

layout(rgba16f, binding = TEX_STORAGE_PREFILTERED_ENVIRONMENT_BINDING) uniform imageCube out_Image;

float RadicalInverse_VdC(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint i, uint N)
{
    return vec2(float(i)/float(N), RadicalInverse_VdC(i));
}

vec3 getTangentImportanceSampleGGX(vec2 Xi, vec3 N, float roughness)
{
    float a = roughness * roughness;

    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a*a - 1.0) * Xi.y));
    float sinTheta = sqrt(1.0 - cosTheta*cosTheta);

    return vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

vec3 getToTexelVector(ivec3 globalID, vec2 imageSize) {
    vec2 uv = ((vec2(globalID.xy) + 0.5) / imageSize) * 2.0 - 1.0;

    vec3 dir;
    int face = globalID.z;

    switch(face) {
        case 0: dir = vec3( 1.0,  -uv.y, -uv.x); break; // +X
        case 1: dir = vec3(-1.0,  -uv.y,  uv.x); break; // -X
        case 2: dir = vec3( uv.x,   1.0,  uv.y); break; // +Y
        case 3: dir = vec3( uv.x, -1.0, -uv.y); break; // -Y
        case 4: dir = vec3( uv.x, -uv.y,   1.0); break; // +Z
        case 5: dir = vec3(-uv.x, -uv.y,  -1.0); break; // -Z
    }
    return normalize(dir);
}

void main() {
    ivec3 texelCoord = ivec3(gl_GlobalInvocationID.xyz);
    vec2 imgSize = vec2(imageSize(out_Image));

    if (texelCoord.x >= imgSize.x || texelCoord.y >= imgSize.y) {
        return;
    }

    vec3 N = getToTexelVector(texelCoord, imgSize);
    vec3 R = N;
    vec3 V = R;

    vec3 worldTanUp = vec3(0.0f, 1.0f, 0.0f);
    vec3 worldTanRight = vec3(0.0f);
    vec3 worldTanForward = N;

    if(abs(dot(worldTanUp, worldTanForward)) > 0.999f) {
        worldTanUp = vec3(0.0f, 0.0f, 1.0f);
    }
    worldTanRight = normalize(cross(worldTanUp, worldTanForward));
    worldTanUp = normalize(cross(worldTanForward, worldTanRight));

    vec3 prefilteredColor = vec3(0.0f);
    float totalWeight = 0.0;
    for(uint i = 0u; i < u_EnvBakeData.SampleCount; ++i)
    {
        vec2 Xi = Hammersley(i, u_EnvBakeData.SampleCount);
        vec3 tangentSample  = getTangentImportanceSampleGGX(Xi, N, u_EnvBakeData.Roughness);
        vec3 worldSample = tangentSample.x * worldTanRight + tangentSample.y * worldTanUp + tangentSample.z * worldTanForward;
        vec3 L  = normalize(2.0 * dot(V, worldSample) * worldSample - V);

        float NdotL = max(dot(N, L), 0.0);
        if(NdotL > 0.0)
        {
            prefilteredColor += textureLod(t_RadianceMap, L, 0.0).rgb * NdotL;
            totalWeight      += NdotL;
        }
    }
    prefilteredColor = prefilteredColor / totalWeight;

    imageStore(out_Image, texelCoord, vec4(prefilteredColor, 1.0f));
}